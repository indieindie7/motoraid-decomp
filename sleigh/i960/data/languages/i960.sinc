}
:movr fs1,fdst is op8=0x6c & op2=0x9 & fs1 & fdst {
  fdst = fs1;
}
:movrl fs1d,fdstd is op8=0x6d & op2=0x9 & fs1d & fdstd {
  fdstd = fs1d;
}
:movre fs1,fdst is op8=0x6e & op2=0x1 & fs1 & fdst {
  fdst = movre(fs1);
}
:movre fs1,fdst is op8=0x6e & op2=0x9 & fs1 & fdst {
  fdst = movre(fs1);
}
:cpysre fs1,fs2,fdst is op8=0x6e & op2=0x2 & fs1 & fs2 & fdst {
  fdst = cpysre(fs1, fs2);
}
:cpyrsre fs1,fs2,fdst is op8=0x6e & op2=0x3 & fs1 & fs2 & fdst {
  fdst = cpyrsre(fs1, fs2);
}
:divr fs1,fs2,fdst is op8=0x78 & op2=0xb & fs1 & fs2 & fdst {
  fdst = fs2 f/ fs1;
}
:mulr fs1,fs2,fdst is op8=0x78 & op2=0xc & fs1 & fs2 & fdst {
  fdst = fs2 f* fs1;
}
:subr fs1,fs2,fdst is op8=0x78 & op2=0xd & fs1 & fs2 & fdst {
  fdst = fs2 f- fs1;
}
:addr fs1,fs2,fdst is op8=0x78 & op2=0xf & fs1 & fs2 & fdst {
  fdst = fs2 f+ fs1;
}
:divrl fs1d,fs2d,fdstd is op8=0x79 & op2=0xb & fs1d & fs2d & fdstd {
  fdstd = fs2d f/ fs1d;
}
:mulrl fs1d,fs2d,fdstd is op8=0x79 & op2=0xc & fs1d & fs2d & fdstd {
  fdstd = fs2d f* fs1d;
}
:subrl fs1d,fs2d,fdstd is op8=0x79 & op2=0xd & fs1d & fs2d & fdstd {
  fdstd = fs2d f- fs1d;
}
:addrl fs1d,fs2d,fdstd is op8=0x79 & op2=0xf & fs1d & fs2d & fdstd {
  fdstd = fs2d f+ fs1d;
}

# ---- p-code ops
