# ---- CTRL format
cdest: res is cdisp22 [ res = (inst_start + (cdisp22 * 4)) & 0xffffffff; ] { export *:4 res; }
:b cdest is op8=0x08 & cbit0=0 & cdest {
  goto cdest;
}
:call cdest is op8=0x09 & cbit0=0 & cdest {
  call cdest;
}
:ret is op8=0x0a & cbit0=0 {
  local t:4 = rip;
  return [t];
}
:bal cdest is op8=0x0b & cbit0=0 & cdest {
  g14 = inst_next;
  call cdest;
}
:bno cdest is op8=0x10 & cbit0=0 & cdest {
  if ((CCL == 0 && CCE == 0 && CCG == 0)) goto cdest;
}
:faultno is op8=0x18 & cbit0=0 {
  if (!((CCL == 0 && CCE == 0 && CCG == 0))) goto inst_next;
  faultop();
}
:testno rd_r is op8=0x20 & rd_r {
  local t:1 = (CCL == 0 && CCE == 0 && CCG == 0);
  rd_r = zext(t);
}
:bg cdest is op8=0x11 & cbit0=0 & cdest {
  if (CCG != 0) goto cdest;
}
:faultg is op8=0x19 & cbit0=0 {
  if (!(CCG != 0)) goto inst_next;
  faultop();
}
:testg rd_r is op8=0x21 & rd_r {
  local t:1 = CCG != 0;
  rd_r = zext(t);
}
:be cdest is op8=0x12 & cbit0=0 & cdest {
  if (CCE != 0) goto cdest;
}
:faulte is op8=0x1a & cbit0=0 {
  if (!(CCE != 0)) goto inst_next;
  faultop();
}
:teste rd_r is op8=0x22 & rd_r {
  local t:1 = CCE != 0;
  rd_r = zext(t);
}
:bge cdest is op8=0x13 & cbit0=0 & cdest {
  if (CCL == 0) goto cdest;
}
:faultge is op8=0x1b & cbit0=0 {
  if (!(CCL == 0)) goto inst_next;
  faultop();
}
:testge rd_r is op8=0x23 & rd_r {
  local t:1 = CCL == 0;
  rd_r = zext(t);
}
:bl cdest is op8=0x14 & cbit0=0 & cdest {
  if (CCL != 0) goto cdest;
}
:faultl is op8=0x1c & cbit0=0 {
  if (!(CCL != 0)) goto inst_next;
  faultop();
}
:testl rd_r is op8=0x24 & rd_r {
  local t:1 = CCL != 0;
  rd_r = zext(t);
}
:bne cdest is op8=0x15 & cbit0=0 & cdest {
  if (CCE == 0) goto cdest;
}
:faultne is op8=0x1d & cbit0=0 {
  if (!(CCE == 0)) goto inst_next;
  faultop();
}
:testne rd_r is op8=0x25 & rd_r {
  local t:1 = CCE == 0;
  rd_r = zext(t);
}
:ble cdest is op8=0x16 & cbit0=0 & cdest {
  if (CCG == 0) goto cdest;
}
:faultle is op8=0x1e & cbit0=0 {
  if (!(CCG == 0)) goto inst_next;
  faultop();
}
:testle rd_r is op8=0x26 & rd_r {
  local t:1 = CCG == 0;
  rd_r = zext(t);
}
:bo cdest is op8=0x17 & cbit0=0 & cdest {
  if ((CCL != 0 || CCE != 0 || CCG != 0)) goto cdest;
}
:faulto is op8=0x1f & cbit0=0 {
  if (!((CCL != 0 || CCE != 0 || CCG != 0))) goto inst_next;
  faultop();
}
:testo rd_r is op8=0x27 & rd_r {
  local t:1 = (CCL != 0 || CCE != 0 || CCG != 0);
  rd_r = zext(t);
}

# ---- COBR format
cdest13: res is cdisp13 [ res = (inst_start + (cdisp13 * 4)) & 0xffffffff; ] { export *:4 res; }
csrc1: rd_r is m3=0 & rd_r { export rd_r; }
csrc1: rd_lit is m3=1 & rd_lit { export *[const]:4 rd_lit; }
csrc2: rb_r is cbit0=0 & rb_r { export rb_r; }
csrc2: rb_sf is cbit0=1 & rb_sf { export rb_sf; }
:bbc csrc1,csrc2,cdest13 is op8=0x30 & csrc1 & csrc2 & cdest13 {
  local bit:4 = (csrc2 >> csrc1) & 1;
  CCL = 0; CCG = 0; CCE = (bit != 0);
  if (bit == 0) goto cdest13;
}
:bbs csrc1,csrc2,cdest13 is op8=0x37 & csrc1 & csrc2 & cdest13 {
  local bit:4 = (csrc2 >> csrc1) & 1;
  CCL = 0; CCG = 0; CCE = (bit != 0);
  if (bit != 0) goto cdest13;
}
:cmpobg csrc1,csrc2,cdest13 is op8=0x31 & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a < b; CCE = a == b; CCG = a > b;
  if (a > b) goto cdest13;
}
:cmpobe csrc1,csrc2,cdest13 is op8=0x32 & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a < b; CCE = a == b; CCG = a > b;
  if (a == b) goto cdest13;
}
:cmpobge csrc1,csrc2,cdest13 is op8=0x33 & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a < b; CCE = a == b; CCG = a > b;
  if (a >= b) goto cdest13;
}
:cmpobl csrc1,csrc2,cdest13 is op8=0x34 & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a < b; CCE = a == b; CCG = a > b;
  if (a < b) goto cdest13;
}
:cmpobne csrc1,csrc2,cdest13 is op8=0x35 & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a < b; CCE = a == b; CCG = a > b;
  if (a != b) goto cdest13;
}
:cmpoble csrc1,csrc2,cdest13 is op8=0x36 & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a < b; CCE = a == b; CCG = a > b;
  if (a <= b) goto cdest13;
}
:cmpibno csrc1,csrc2,cdest13 is op8=0x38 & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a s< b; CCE = a == b; CCG = a s> b;
}
:cmpibg csrc1,csrc2,cdest13 is op8=0x39 & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a s< b; CCE = a == b; CCG = a s> b;
  if (a s> b) goto cdest13;
}
:cmpibe csrc1,csrc2,cdest13 is op8=0x3a & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a s< b; CCE = a == b; CCG = a s> b;
  if (a == b) goto cdest13;
}
:cmpibge csrc1,csrc2,cdest13 is op8=0x3b & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a s< b; CCE = a == b; CCG = a s> b;
  if (a s>= b) goto cdest13;
}
:cmpibl csrc1,csrc2,cdest13 is op8=0x3c & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a s< b; CCE = a == b; CCG = a s> b;
  if (a s< b) goto cdest13;
}
:cmpibne csrc1,csrc2,cdest13 is op8=0x3d & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a s< b; CCE = a == b; CCG = a s> b;
  if (a != b) goto cdest13;
}
:cmpible csrc1,csrc2,cdest13 is op8=0x3e & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a s< b; CCE = a == b; CCG = a s> b;
  if (a s<= b) goto cdest13;
}
:cmpibo csrc1,csrc2,cdest13 is op8=0x3f & csrc1 & csrc2 & cdest13 {
  local a:4 = csrc1; local b:4 = csrc2;
  CCL = a s< b; CCE = a == b; CCG = a s> b;
  goto cdest13;
}

# ---- MEM format
:ldob ea4,rd_r is op8=0x80 & rd_r & ea4 {
  rd_r = zext(*:1 ea4);
}
:ldob eaV4,rd_r is op8=0x80 & rd_r & eaV4 {
  rd_r = zext(*:1 eaV4);
}
:ldob extd^ea8,rd_r is op8=0x80 & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  rd_r = zext(*:1 ea);
}
:ldos ea4,rd_r is op8=0x88 & rd_r & ea4 {
  rd_r = zext(*:2 ea4);
}
:ldos eaV4,rd_r is op8=0x88 & rd_r & eaV4 {
  rd_r = zext(*:2 eaV4);
}
:ldos extd^ea8,rd_r is op8=0x88 & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  rd_r = zext(*:2 ea);
}
:ld ea4,rd_r is op8=0x90 & rd_r & ea4 {
  rd_r = *:4 ea4;
}
:ld eaV4,rd_r is op8=0x90 & rd_r & eaV4 {
  rd_r = *:4 eaV4;
}
:ld extd^ea8,rd_r is op8=0x90 & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  rd_r = *:4 ea;
}
:ldl ea4,mp is op8=0x98 & mp & ea4 {
  mp = *:8 ea4;
}
:ldl eaV4,mp is op8=0x98 & mp & eaV4 {
  mp = *:8 eaV4;
}
:ldl extd^ea8,mp is op8=0x98 & mp & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  mp = *:8 ea;
}
:ldt ea4,mt is op8=0xa0 & mt & ea4 {
  mt = *:12 ea4;
}
:ldt eaV4,mt is op8=0xa0 & mt & eaV4 {
  mt = *:12 eaV4;
}
:ldt extd^ea8,mt is op8=0xa0 & mt & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  mt = *:12 ea;
}
:ldq ea4,mq is op8=0xb0 & mq & ea4 {
  mq = *:16 ea4;
}
:ldq eaV4,mq is op8=0xb0 & mq & eaV4 {
  mq = *:16 eaV4;
}
:ldq extd^ea8,mq is op8=0xb0 & mq & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  mq = *:16 ea;
}
:ldib ea4,rd_r is op8=0xc0 & rd_r & ea4 {
  rd_r = sext(*:1 ea4);
}
:ldib eaV4,rd_r is op8=0xc0 & rd_r & eaV4 {
  rd_r = sext(*:1 eaV4);
}
:ldib extd^ea8,rd_r is op8=0xc0 & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  rd_r = sext(*:1 ea);
}
:ldis ea4,rd_r is op8=0xc8 & rd_r & ea4 {
  rd_r = sext(*:2 ea4);
}
:ldis eaV4,rd_r is op8=0xc8 & rd_r & eaV4 {
  rd_r = sext(*:2 eaV4);
}
:ldis extd^ea8,rd_r is op8=0xc8 & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  rd_r = sext(*:2 ea);
}
:lda ea4,rd_r is op8=0x8c & rd_r & ea4 {
  rd_r = ea4;
}
:lda eaV4,rd_r is op8=0x8c & rd_r & eaV4 {
  rd_r = eaV4;
}
:lda extd^ea8,rd_r is op8=0x8c & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  rd_r = ea;
}
:stob rd_r,ea4 is op8=0x82 & rd_r & ea4 {
  *:1 ea4 = rd_r:1;
}
:stob rd_r,eaV4 is op8=0x82 & rd_r & eaV4 {
  *:1 eaV4 = rd_r:1;
}
:stob rd_r,extd^ea8 is op8=0x82 & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  *:1 ea = rd_r:1;
}
:stos rd_r,ea4 is op8=0x8a & rd_r & ea4 {
  *:2 ea4 = rd_r:2;
}
:stos rd_r,eaV4 is op8=0x8a & rd_r & eaV4 {
  *:2 eaV4 = rd_r:2;
}
:stos rd_r,extd^ea8 is op8=0x8a & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  *:2 ea = rd_r:2;
}
:st rd_r,ea4 is op8=0x92 & rd_r & ea4 {
  *:4 ea4 = rd_r;
}
:st rd_r,eaV4 is op8=0x92 & rd_r & eaV4 {
  *:4 eaV4 = rd_r;
}
:st rd_r,extd^ea8 is op8=0x92 & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  *:4 ea = rd_r;
}
:stl mp,ea4 is op8=0x9a & mp & ea4 {
  *:8 ea4 = mp;
}
:stl mp,eaV4 is op8=0x9a & mp & eaV4 {
  *:8 eaV4 = mp;
}
:stl mp,extd^ea8 is op8=0x9a & mp & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  *:8 ea = mp;
}
:stt mt,ea4 is op8=0xa2 & mt & ea4 {
  *:12 ea4 = mt;
}
:stt mt,eaV4 is op8=0xa2 & mt & eaV4 {
  *:12 eaV4 = mt;
}
:stt mt,extd^ea8 is op8=0xa2 & mt & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  *:12 ea = mt;
}
:stq mq,ea4 is op8=0xb2 & mq & ea4 {
  *:16 ea4 = mq;
}
:stq mq,eaV4 is op8=0xb2 & mq & eaV4 {
  *:16 eaV4 = mq;
}
:stq mq,extd^ea8 is op8=0xb2 & mq & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  *:16 ea = mq;
}
:stib rd_r,ea4 is op8=0xc2 & rd_r & ea4 {
  *:1 ea4 = rd_r:1;
}
:stib rd_r,eaV4 is op8=0xc2 & rd_r & eaV4 {
  *:1 eaV4 = rd_r:1;
}
:stib rd_r,extd^ea8 is op8=0xc2 & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  *:1 ea = rd_r:1;
}
:stis rd_r,ea4 is op8=0xca & rd_r & ea4 {
  *:2 ea4 = rd_r:2;
}
:stis rd_r,eaV4 is op8=0xca & rd_r & eaV4 {
  *:2 eaV4 = rd_r:2;
}
:stis rd_r,extd^ea8 is op8=0xca & rd_r & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  *:2 ea = rd_r:2;
}
:dcinva ea4 is op8=0xad & ea4 {
  dcinva(ea4);
}
:dcinva eaV4 is op8=0xad & eaV4 {
  dcinva(eaV4);
}
:dcinva extd^ea8 is op8=0xad & ea8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = ea8 + extd;
  dcinva(ea);
}
:bx eaK4 is op8=0x84 & eaK4 {
  goto eaK4;
}
:bx eaV4 is op8=0x84 & eaV4 {
  goto [eaV4];
}
:bx extd^eaV8 is op8=0x84 & eaV8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = eaV8 + extd;
  goto [ea];
}
:callx eaK4 is op8=0x86 & eaK4 {
  call eaK4;
}
:callx eaV4 is op8=0x86 & eaV4 {
  local t:4 = eaV4;
  call [t];
}
:callx extd^eaV8 is op8=0x86 & eaV8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = eaV8 + extd;
  local t:4 = ea;
  call [t];
}
:balx eaK4,rd_r is op8=0x85 & rd_r & eaK4 {
  rd_r = inst_next;
  call eaK4;
}
:balx eaV4,rd_r is op8=0x85 & rd_r & eaV4 {
  local t:4 = eaV4;
  rd_r = inst_next;
  call [t];
}
:balx extd^eaV8,rd_r is op8=0x85 & rd_r & eaV8 & (memmode=5 | memmode>=12) ; extd {
  local ea:4 = eaV8 + extd;
  local t:4 = ea;
  rd_r = inst_next;
  call [t];
}
:bx ktgt is op8=0x84 & memmode=12 & mb56=0 & scale<=4 ; ktgt {
  goto ktgt;
}
:bx ktgt5 is op8=0x84 & memmode=5 & mb56=0 & scale<=4 ; ktgt5 {
  goto ktgt5;
}
:callx ktgt is op8=0x86 & memmode=12 & mb56=0 & scale<=4 ; ktgt {
  call ktgt;
}
:callx ktgt5 is op8=0x86 & memmode=5 & mb56=0 & scale<=4 ; ktgt5 {
  call ktgt5;
}
:balx ktgt,rd_r is op8=0x85 & rd_r & memmode=12 & mb56=0 & scale<=4 ; ktgt {
  rd_r = inst_next; call ktgt;
}
:balx ktgt5,rd_r is op8=0x85 & rd_r & memmode=5 & mb56=0 & scale<=4 ; ktgt5 {
  rd_r = inst_next; call ktgt5;
}

# ---- REG format
:notbit src1,src2,dst is op8=0x58 & op2=0x0 & src1 & src2 & dst {
  local m:4 = 1;
  m = m << (src1 & 31);
  dst = src2 ^ m;
}
:and src1,src2,dst is op8=0x58 & op2=0x1 & src1 & src2 & dst {
  dst = src2 & src1;
}
:andnot src1,src2,dst is op8=0x58 & op2=0x2 & src1 & src2 & dst {
  dst = src2 & ~src1;
}
:setbit src1,src2,dst is op8=0x58 & op2=0x3 & src1 & src2 & dst {
  local m:4 = 1;
  m = m << (src1 & 31);
  dst = src2 | m;
}
:notand src1,src2,dst is op8=0x58 & op2=0x4 & src1 & src2 & dst {
  dst = ~src2 & src1;
}
:xor src1,src2,dst is op8=0x58 & op2=0x6 & src1 & src2 & dst {
  dst = src2 ^ src1;
}
:or src1,src2,dst is op8=0x58 & op2=0x7 & src1 & src2 & dst {
  dst = src2 | src1;
}
:nor src1,src2,dst is op8=0x58 & op2=0x8 & src1 & src2 & dst {
  dst = ~(src2 | src1);
}
:xnor src1,src2,dst is op8=0x58 & op2=0x9 & src1 & src2 & dst {
  dst = ~(src2 ^ src1);
}
:not src1,dst is op8=0x58 & op2=0xa & src1 & dst {
  dst = ~src1;
}
:ornot src1,src2,dst is op8=0x58 & op2=0xb & src1 & src2 & dst {
  dst = src2 | ~src1;
}
:clrbit src1,src2,dst is op8=0x58 & op2=0xc & src1 & src2 & dst {
  local m:4 = 1;
  m = m << (src1 & 31);
  dst = src2 & ~m;
}
:notor src1,src2,dst is op8=0x58 & op2=0xd & src1 & src2 & dst {
  dst = ~src2 | src1;
}
:nand src1,src2,dst is op8=0x58 & op2=0xe & src1 & src2 & dst {
  dst = ~(src2 & src1);
}
:alterbit src1,src2,dst is op8=0x58 & op2=0xf & src1 & src2 & dst {
  local m:4 = 1;
  m = m << (src1 & 31);
  local f:4 = zext(CCE);
  dst = (src2 & ~m) | ((0 - f) & m);
}
:addo src1,src2,dst is op8=0x59 & op2=0x0 & src1 & src2 & dst {
  dst = src2 + src1;
}
:addi src1,src2,dst is op8=0x59 & op2=0x1 & src1 & src2 & dst {
  dst = src2 + src1;
}
:subo src1,src2,dst is op8=0x59 & op2=0x2 & src1 & src2 & dst {
  dst = src2 - src1;
}
:subi src1,src2,dst is op8=0x59 & op2=0x3 & src1 & src2 & dst {
  dst = src2 - src1;
}
:cmpob src1,src2 is op8=0x59 & op2=0x4 & src1 & src2 {
  local a:1 = src1:1;
  local b:1 = src2:1;
  CCL = a < b;
  CCE = a == b;
  CCG = a > b;
}
:cmpib src1,src2 is op8=0x59 & op2=0x5 & src1 & src2 {
  local a:1 = src1:1;
  local b:1 = src2:1;
  CCL = a s< b;
  CCE = a == b;
  CCG = a s> b;
}
:cmpos src1,src2 is op8=0x59 & op2=0x6 & src1 & src2 {
  local a:2 = src1:2;
  local b:2 = src2:2;
  CCL = a < b;
  CCE = a == b;
  CCG = a > b;
}
:cmpis src1,src2 is op8=0x59 & op2=0x7 & src1 & src2 {
  local a:2 = src1:2;
  local b:2 = src2:2;
  CCL = a s< b;
  CCE = a == b;
  CCG = a s> b;
}
:shro src1,src2,dst is op8=0x59 & op2=0x8 & src1 & src2 & dst {
  dst = src2 >> src1;
}
:shrdi src1,src2,dst is op8=0x59 & op2=0xa & src1 & src2 & dst {
  local d:4 = 1;
  d = d << src1;
  dst = src2 s/ d;
}
:shri src1,src2,dst is op8=0x59 & op2=0xb & src1 & src2 & dst {
  dst = src2 s>> src1;
}
:shlo src1,src2,dst is op8=0x59 & op2=0xc & src1 & src2 & dst {
  dst = src2 << src1;
}
:rotate src1,src2,dst is op8=0x59 & op2=0xd & src1 & src2 & dst {
  local c:4 = src1 & 31;
  dst = (src2 << c) | (src2 >> (32 - c));
}
:shli src1,src2,dst is op8=0x59 & op2=0xe & src1 & src2 & dst {
  dst = src2 << src1;
}
:cmpo src1,src2 is op8=0x5a & op2=0x0 & src1 & src2 {
  local a:4 = src1;
  local b:4 = src2;
  CCL = a < b;
  CCE = a == b;
  CCG = a > b;
}
:cmpi src1,src2 is op8=0x5a & op2=0x1 & src1 & src2 {
  local a:4 = src1;
  local b:4 = src2;
  CCL = a s< b;
  CCE = a == b;
  CCG = a s> b;
}
:concmpo src1,src2 is op8=0x5a & op2=0x2 & src1 & src2 {
  local a:4 = src1;
  local b:4 = src2;
  if (CCL != 0) goto inst_next;
  CCE = a <= b;
  CCG = a > b;
}
:concmpi src1,src2 is op8=0x5a & op2=0x3 & src1 & src2 {
  local a:4 = src1;
  local b:4 = src2;
  if (CCL != 0) goto inst_next;
  CCE = a s<= b;
  CCG = a s> b;
}
:cmpinco src1,src2,dst is op8=0x5a & op2=0x4 & src1 & src2 & dst {
  local a:4 = src1;
  local b:4 = src2;
  CCL = a < b;
  CCE = a == b;
  CCG = a > b;
  dst = b + 1;
}
:cmpinci src1,src2,dst is op8=0x5a & op2=0x5 & src1 & src2 & dst {
  local a:4 = src1;
  local b:4 = src2;
  CCL = a s< b;
  CCE = a == b;
  CCG = a s> b;
  dst = b + 1;
}
:cmpdeco src1,src2,dst is op8=0x5a & op2=0x6 & src1 & src2 & dst {
  local a:4 = src1;
  local b:4 = src2;
  CCL = a < b;
  CCE = a == b;
  CCG = a > b;
  dst = b - 1;
}
:cmpdeci src1,src2,dst is op8=0x5a & op2=0x7 & src1 & src2 & dst {
  local a:4 = src1;
  local b:4 = src2;
  CCL = a s< b;
  CCE = a == b;
  CCG = a s> b;
  dst = b - 1;
}
:scanbyte src1,src2 is op8=0x5a & op2=0xc & src1 & src2 {
  local x:4 = src1 ^ src2;
  local x1:4 = x >> 8;
  local x2:4 = x >> 16;
  local x3:4 = x >> 24;
  CCL = 0;
  CCG = 0;
  CCE = (x:1 == 0) || (x1:1 == 0) || (x2:1 == 0) || (x3:1 == 0);
}
:bswap src1,dst is op8=0x5a & op2=0xd & src1 & dst {
